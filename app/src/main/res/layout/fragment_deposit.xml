<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Guest overlay -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutGuestOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorErrorContainer"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guest_send_disabled"
                android:padding="12dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/deposit_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/deposit_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="20dp" />

        <!-- Standard ACH -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/deposit_ach_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/deposit_ach_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/deposit_fee_free" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorPrimary" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Instant deposit -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInstant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/deposit_instant_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/deposit_instant_desc" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/deposit_fee_instant" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="?attr/colorTertiary" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManagePaymentMethods"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_payment_methods" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
